<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>AzRebit</Title>
    <Authors>Petar Soce</Authors>
    <Description>A .NET library that simplifies Azure Function run resubmission by providing extension methods for saving, tracking, and recovering processing operations.</Description>
    <PackageIcon>azrebit-logo-socials (Small).png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>2.0.9</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <RepositoryUrl>https://github.com/FlipFlop17/AzRebit</RepositoryUrl>
    <PackageTags>azrebit;azurefunctionretry;azfuncresubmit;isolated-worker</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>b1da1667-cc56-4d6f-a9e4-5afbcdc7ea0f</UserSecretsId>
  </PropertyGroup>

<ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />

    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.25.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Core" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" Version="6.8.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.3" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Tables" Version="1.5.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AzRebitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\resources\azrebit-logo-socials (Small).png" Link="nuget-res\azrebit-logo-socials %28Small%29.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="nuget-res\" />
  </ItemGroup>

</Project>
